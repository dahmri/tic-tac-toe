# Settings for `docker compose` (compose.yaml). Copy to .env and fill in.
# .env holds secrets: never commit it (it is in .gitignore).

# Password for the PostgreSQL user. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Key that encrypts players' names, birth dates and phone numbers.
# Generate once: openssl rand -base64 32
# Keep a copy somewhere safe: without it that data can't be read back.
DATA_ENCRYPTION_KEY=

# Port nginx listens on, on this machine
WEB_PORT=8080

# Number of game server containers behind nginx
API_REPLICAS=1

# Database connections per game server container
DB_POOL_SIZE=20

# Milliseconds a player has to come back after their connection drops (a
# reload, a network blip) before they forfeit their match and leave the
# quick-match queue
# LEAVE_GRACE_MS=20000

# The site's public address. Links in emails point here. Required in
# production.
SITE_URL=https://tictactoe.example.com

# Email, for confirming players' addresses: any SMTP server works (Brevo,
# Mailgun, Postmark, Amazon SES, Resend...). Without SMTP_HOST, emails are
# only written to the server log. SMTP_SECURE=true for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pencil Tic-Tac-Toe <no-reply@tictactoe.example.com>"

# Sign-up check: a proof-of-work puzzle the browser solves (server/challenge.js).
# 18 bits takes a second or two on a phone. Tests make it easy:
# SIGNUP_CHALLENGE_BITS=18
# SIGNUP_CHALLENGE_MIN_MS=1000

# Tests only: keep emails in Redis and let the browser tests read them
# back. Never turn this on in production.
# MAIL_OUTBOX=on

# Milliseconds a player has for each move in an online match; running out
# loses the round
# TURN_MS=30000
